# API
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
EXPO_PUBLIC_TENANT_SLUG=gocart
EXPO_PUBLIC_API_TIMEOUT_MS=15000
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_ALLOW_INSECURE_API=false

# Google auth (public OAuth client IDs from the same Google/Firebase project)
# Web client: used by Django to verify Google access tokens and by browser fallback.
# Android client: package com.gocart.mobile plus the SHA-1 of the build signing key.
# iOS client: bundle id com.gocart.mobile if/when iOS Google login is enabled.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-web-client.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=000000000000-android-client.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-ios-client.apps.googleusercontent.com

# Payments
# Public gateway identifier only. Real secret keys belong on the backend.
EXPO_PUBLIC_CARD_PAYMENT_GATEWAY=placeholder

# App configuration
EXPO_PUBLIC_APP_NAME=GoCart
EXPO_PUBLIC_APP_SLUG=gocart-mobile
EXPO_PUBLIC_APP_SCHEME=gocartmobile
EXPO_PUBLIC_ANDROID_PACKAGE=com.gocart.mobile
EXPO_PUBLIC_IOS_BUNDLE_ID=com.gocart.mobile
EXPO_PUBLIC_EAS_PROJECT_ID=
